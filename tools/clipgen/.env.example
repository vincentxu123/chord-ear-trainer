# Copy to .env and fill in. .env is gitignored.

# --- Suno provider (default targets kie.ai) ---
SUNO_API_KEY=your-key-here
SUNO_API_BASE=https://api.kie.ai
SUNO_MODEL=V4
SUNO_POLL_INTERVAL=5
SUNO_POLL_MAX=60

# --- detection / acceptance gate (optional overrides) ---
# CLIPGEN_INCLUDE_DIM=0
# CLIPGEN_CHORDS_MIN=3
# CLIPGEN_CHORDS_MAX=4
# CLIPGEN_CONF_MIN=0.55
# CLIPGEN_WINDOW_MIN=8
# CLIPGEN_WINDOW_MAX=18
# CLIPGEN_MIN_CHORD_SEC=0.6
