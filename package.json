{
  "name": "chord-ear-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clips:generate": "tsx scripts/generateClips.ts",
    "clips:qc": ".venv-qc/Scripts/python.exe scripts/qcClips.py",
    "songs:youtube": ".venv-recordings/bin/python scripts/recordings/download_youtube.py",
    "songs:process": ".venv-recordings/bin/python scripts/recordings/process_song.py",
    "songs:export": ".venv-recordings/bin/python scripts/recordings/export_candidates.py",
    "songs:instrumentals": ".venv-recordings/bin/python scripts/recordings/backfill_instrumentals.py"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tonal": "^6.4.3",
    "tone": "^15.1.22",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
